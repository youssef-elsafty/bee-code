# ==============================================================================
# Egyptian Programming Academy Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values according to your environment.
# DO NOT commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL & APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment mode: 'production' or 'development'
NODE_ENV=production

# Django Debug mode: Set to 'False' in production! Set to 'True' ONLY for local dev.
DEBUG=False

# Django Secret Key: Cryptographic key used for security signing.
# Generate a unique secret key for production (e.g. using `openssl rand -hex 32` or python `get_random_secret_key()`)
SECRET_KEY=django-insecure-change-me-to-a-very-long-and-secure-random-string-in-production-1234567890!@#$%^&*()

# Initial administrator account. Use a unique password and do not commit the real value.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@beecode.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Set to true for one deployment only when rotating an existing password.
ADMIN_RESET_PASSWORD=false

# Allowed Hosts: Comma-separated list of host/domain names that this Django site can serve.
ALLOWED_HOSTS=egyptianacademy.org,www.egyptianacademy.org,localhost,127.0.0.1,backend

# Domain name for SSL certificates and cross-origin configuration
DOMAIN_NAME=egyptianacademy.org

# Email address for SSL Let's Encrypt renewal notifications
SSL_EMAIL=admin@egyptianacademy.org

# ------------------------------------------------------------------------------
# 2. CORS & CSRF SECURITY SETTINGS
# ------------------------------------------------------------------------------
# CORS Allowed Origins: Comma-separated HTTP/HTTPS origins allowed to make cross-site requests
CORS_ALLOWED_ORIGINS=https://egyptianacademy.org,https://www.egyptianacademy.org,http://localhost:3000,http://127.0.0.1:3000

# CSRF Trusted Origins: Comma-separated origins for trusted CSRF requests
CSRF_TRUSTED_ORIGINS=https://egyptianacademy.org,https://www.egyptianacademy.org,http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=egyptian_academy_db
POSTGRES_USER=academy_user
POSTGRES_PASSWORD=academy_secure_password_change_in_prod_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full Database URL used by Django DATABASES setting (dj_database_url)
DATABASE_URL=postgres://academy_user:academy_secure_password_change_in_prod_2026@db:5432/egyptian_academy_db

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Message Broker & Result Backend URLs
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. FRONTEND (NEXT.JS) CONFIGURATION
# ------------------------------------------------------------------------------
# Frontend listening port inside container
PORT=3000

# Public API URL accessible from the browser
NEXT_PUBLIC_API_URL=https://egyptianacademy.org/api/v1

# Public WebSocket URL for real-time notifications/code execution status
NEXT_PUBLIC_WS_URL=wss://egyptianacademy.org/ws

# ------------------------------------------------------------------------------
# 6. STATIC AND MEDIA FILE STORAGE
# ------------------------------------------------------------------------------
# Path where Django collects static files
STATIC_ROOT=/app/staticfiles

# Path where Django stores user-uploaded media (e.g. avatar images, code submissions)
MEDIA_ROOT=/app/media

# ------------------------------------------------------------------------------
# 7. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@egyptianacademy.org
EMAIL_HOST_PASSWORD=your-app-specific-email-password
DEFAULT_FROM_EMAIL=Egyptian Programming Academy <noreply@egyptianacademy.org>
